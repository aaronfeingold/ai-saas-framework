{
  "name": "ai-saas-framework",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "wizard": "pnpm --filter @ai-saas/wizard start",
    "check": "biome check . && pnpm -r --filter=!@ai-saas/web typecheck && pnpm -r --filter=!@ai-saas/web test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose -f template/docker-compose.yml up -d postgres",
    "dev": "pnpm --parallel --filter @ai-saas/api --filter @ai-saas/web dev",
    "build": "pnpm --filter @ai-saas/agent-kit build && pnpm --filter @ai-saas/api build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json}": "biome check --write --no-errors-on-unmatched"
  }
}
