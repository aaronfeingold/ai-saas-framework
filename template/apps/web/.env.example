# Web app environment. Copy to .env.local and fill in. The wizard writes this for you.

# Supabase: auth, profiles, sessions
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# PostgreSQL with pgvector: business data and embeddings
DATABASE_URL=postgresql://app:app@127.0.0.1:55435/app
POSTGRES_URL=postgresql://app:app@127.0.0.1:55435/app
VECTOR_DATABASE_URL=postgresql://app:app@127.0.0.1:55435/app

# Redis (Upstash): caching and rate limits
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# Model providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
PERPLEXITY_API_KEY=
VOYAGE_API_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@example.com
RESEND_REPLY_TO_EMAIL=support@example.com

# URLs
BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
