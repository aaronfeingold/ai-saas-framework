# API environment. Copy to .env and fill in. The wizard writes this for you.
DATABASE_URL=postgresql://app:app@127.0.0.1:55435/app
CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_SECRET=  # only for projects on the legacy shared secret
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL=anthropic:claude-haiku-5-5
SUMMARY_MODEL=anthropic:claude-haiku-5-5
