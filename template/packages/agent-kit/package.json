{
  "name": "@ai-saas/agent-kit",
  "version": "0.1.0",
  "private": true,
  "description": "A framework for agents built on the Vercel AI SDK: one definition per capability becomes a route, an OpenAPI entry and a tool; a streaming chat endpoint with spend control; storage behind one interface.",
  "type": "module",
  "exports": {
    ".": {
      "ai-saas-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tracing": {
      "ai-saas-source": "./src/telemetry/tracing.ts",
      "types": "./dist/telemetry/tracing.d.ts",
      "default": "./dist/telemetry/tracing.js"
    },
    "./testing": {
      "ai-saas-source": "./src/jobs/contract.ts",
      "types": "./dist/jobs/contract.d.ts",
      "default": "./dist/jobs/contract.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@ai-sdk/otel": "^1.0.127",
    "@hono/zod-openapi": "^1.6.3",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "ai": "^7.0.127",
    "hono": "^4.13.12",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "22",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
